# ======================================================================
# CowTalk v5.0 환경변수 (.env.example)
# 이 파일을 .env로 복사한 후 실제 값을 설정하세요.
# ======================================================================

# --- 서버 ---
NODE_ENV=development
PORT=4000

# --- PostgreSQL + TimescaleDB ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cowtalk
DB_USER=cowtalk
DB_PASSWORD=cowtalk_dev_2025

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT 인증 ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- smaXtec API ---
SMAXTEC_API_URL=https://api.smaxtec.com/api/v2
# API 키(sx-...)가 있으면 이메일/비밀번호 대신 사용됨 (smaXtec 웹앱 → Settings → API에서 발급)
SMAXTEC_API_KEY=
SMAXTEC_EMAIL=
SMAXTEC_PASSWORD=
SMAXTEC_ORG_ID=

# --- Kakao Local REST API (주소→좌표 지오코딩, developers.kakao.com) ---
KAKAO_REST_API_KEY=

# --- Anthropic Claude API (CowTalk Chat) ---
ANTHROPIC_API_KEY=

# --- OpenAI TTS (팅커벨 음성 답변) ---
# 키 발급: platform.openai.com → API keys (Audio 권한만 부여 권장)
# 기본값: tts-1 모델 + Nova 음성 + 앞 500자만 합성 (비용 절감)
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1          # tts-1 ($15/1M자) 또는 tts-1-hd ($30/1M자)
# OPENAI_TTS_VOICE=nova           # nova/shimmer/alloy/fable/onyx/echo
# OPENAI_TTS_MAX_CHARS=500        # 응답 앞 N자만 합성 (50~4000)

# --- 공공데이터 API ---
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_BASE_URL=

# --- 날씨 API ---
WEATHER_API_KEY=
WEATHER_API_URL=

# --- 알림 (이메일/SMS) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_API_KEY=
SMS_SENDER=

# --- 프론트엔드 (VITE_ 접두사만 클라이언트 노출) ---
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# --- 로깅 ---
LOG_LEVEL=debug

# ── 음성 어시스턴트 (voice/) ─────────────────────────────
# 공급자는 환경변수로 교체한다. 미설정이면 설정된 것으로 자동 폴백.
VOICE_STT_PROVIDER=whisper          # whisper | clova
VOICE_TTS_PROVIDER=openai           # openai  | clova
# CLOVA (네이버 클라우드) — 한국어 정확도·명료도 우선 경로.
# ⚠️ 키 확보 후 반드시 스모크 테스트할 것 (미검증 어댑터)
CLOVA_CLIENT_ID=
CLOVA_CLIENT_SECRET=
CLOVA_TTS_SPEAKER=nara

# 음성 전용 모델 — 전역 ANTHROPIC_MODEL 은 건드리지 않는다.
# 단순 조회는 빠른 모델로 보내 첫 토큰을 앞당긴다.
VOICE_MODEL_FAST=claude-haiku-4-5
VOICE_MODEL_MAIN=claude-sonnet-4-6
VOICE_MAX_TOKENS=700
VOICE_TEMPERATURE=0.3
VOICE_EFFORT=low
VOICE_TTS_MAX_CHARS=400
VOICE_TTS_SPEED=1.0
VOICE_STT_MIN_CONFIDENCE=0.55

# STT 정확도 — CLOVA 없이 쓰는 설정
# gpt-4o-transcribe 는 whisper-1 과 같은 키·같은 엔드포인트인데 오류율이 낮다.
# 계정이 이 모델을 못 쓰면 서버가 자동으로 whisper-1 로 한 번 재시도한다.
OPENAI_STT_MODEL=gpt-4o-transcribe
# 농장의 실제 개체번호를 STT 힌트로 주입 (번호 공간이 닫혀 있어 효과가 크다)
VOICE_ROSTER_HINTS=true
